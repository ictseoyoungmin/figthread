{
  "name": "figthread",
  "version": "0.6.0",
  "private": true,
  "description": "Semantic figure authoring with promoted visual/profile/layout authority, deterministic SVG rendering, rendered-profile evidence, and semantic motion.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "validate": "node skills/figthread/scripts/validate.mjs",
    "validate:promote": "node skills/figthread/scripts/validate.mjs --promote",
    "visual": "node skills/figthread/scripts/visual.mjs",
    "visual:promote": "node skills/figthread/scripts/visual.mjs --promote",
    "profile": "node skills/figthread/scripts/profile.mjs",
    "profile:promote": "node skills/figthread/scripts/profile.mjs --promote",
    "layout": "node skills/figthread/scripts/layout.mjs",
    "layout:promote": "node skills/figthread/scripts/layout.mjs --promote",
    "render": "node skills/figthread/scripts/render.mjs",
    "render:promote": "node skills/figthread/scripts/render.mjs --promote",
    "motion": "node skills/figthread/scripts/motion.mjs",
    "motion:promote": "node skills/figthread/scripts/motion.mjs --promote"
  },
  "engines": {"node": ">=20"},
  "license": "MIT"
}
