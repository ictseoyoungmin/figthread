{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/run-manifest/0.1",
  "title": "Figthread run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "run_id", "source", "stage_order", "revisions", "active_receipts", "receipt_paths", "invalidations", "checkpoint_sequence", "latest_checkpoint", "status", "run_hash"],
  "properties": {
    "schema_version": {"const": "figthread.run/0.1"},
    "engine_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "original_name", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "original_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "stage_order": {"type": "array", "minItems": 9, "items": {"type": "string", "enum": ["understanding", "claims", "figure-ir", "grammar-visual", "layout", "motion", "document", "review", "export"]}},
    "revisions": {"type": "object"},
    "active_receipts": {"type": "object"},
    "receipt_paths": {"type": "object"},
    "invalidations": {"type": "array", "items": {"type": "object"}},
    "checkpoint_sequence": {"type": "integer", "minimum": 0},
    "latest_checkpoint": {"type": "object"},
    "status": {"type": "string", "enum": ["active", "complete"]},
    "run_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
