{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/browser-text-evidence/0.1",
  "title": "Figthread browser text evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","document_id","plan_hash","observation_hash","environment_hash","build_hash","html_hash","svg_hash","render_hash","layout_hash","profile_threshold_hash","target_id","metrics","evidence_hash"],
  "properties": {
    "schema_version": {"const": "figthread.browser-text-evidence/0.1"},
    "document_id": {"type": "string", "minLength": 1},
    "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "build_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "html_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "svg_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "render_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "layout_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_threshold_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_id": {"type": "string", "minLength": 1},
    "metrics": {"type": "object"},
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
