{
  "schema_version": "figthread.layout-request/0.1",
  "target": {
    "id": "web-wide",
    "profile": "technical-explainer",
    "viewport": { "width": 800, "height": 300 },
    "safe_area": { "top": 20, "right": 20, "bottom": 20, "left": 20 }
  },
  "measurements": [
    { "node_id": "node:input", "min_w": 100, "min_h": 60, "pref_w": 120, "pref_h": 80 },
    { "node_id": "node:queue", "min_w": 100, "min_h": 60, "pref_w": 140, "pref_h": 80 },
    { "node_id": "node:output", "min_w": 100, "min_h": 60, "pref_w": 120, "pref_h": 80 }
  ],
  "options": { "preferred_gap": 32, "min_gap": 12, "container_padding": 16, "routing_grid": 4, "obstacle_margin": 8, "max_crossings": 4 }
}
