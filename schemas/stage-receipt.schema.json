{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/stage-receipt/0.1",
  "title": "Figthread stage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "run_id", "stage_id", "revision", "status", "source_hash", "predecessor_hash", "artifacts", "artifacts_hash", "evidence", "evidence_hash", "authority_hashes", "receipt_hash"],
  "properties": {
    "schema_version": {"const": "figthread.stage-receipt/0.1"},
    "engine_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "stage_id": {"type": "string", "enum": ["understanding", "claims", "figure-ir", "grammar-visual", "layout", "motion", "document", "review", "export"]},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "promoted"},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predecessor_hash": {},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "artifacts_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_hashes": {"type": "object"},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
