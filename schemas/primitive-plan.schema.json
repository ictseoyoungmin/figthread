{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/primitive-plan/0.1",
  "title": "Figthread PrimitivePlan 0.1",
  "type": "object",
  "required": ["schema_version", "figure_hash", "visual_hash", "registry_hash", "engine_version", "bindings", "measurements", "intrinsic_metrics_hash", "plan_hash"],
  "properties": {
    "schema_version": { "const": "figthread.primitive-plan/0.1" },
    "figure_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "visual_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "registry_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "engine_version": { "type": "string" },
    "bindings": { "type": "array", "minItems": 1 },
    "measurements": { "type": "array" },
    "intrinsic_metrics_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "plan_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
