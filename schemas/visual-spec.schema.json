{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/visual-spec/0.1",
  "title": "Figthread VisualSpec 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figure_id", "registry_hash", "bindings", "custom_definitions", "extensions"],
  "properties": {
    "schema_version": { "const": "figthread.visual/0.1" },
    "figure_id": { "type": "string", "pattern": "^fig:[a-z0-9][a-z0-9._-]*$" },
    "registry_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "primitive", "variant", "salience", "props", "state_bindings"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^node:[a-z0-9][a-z0-9._-]*$" },
          "primitive": { "type": "string", "pattern": "^(?:core|custom)\\.[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+$" },
          "variant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "salience": { "type": "string", "enum": ["S0", "S1", "S2", "S3"] },
          "props": { "type": "object" },
          "state_bindings": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9._:-]*$" } }
        }
      }
    },
    "custom_definitions": { "type": "array", "items": { "type": "object" } },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*:[a-z0-9][a-z0-9._-]*$" } }
  }
}
