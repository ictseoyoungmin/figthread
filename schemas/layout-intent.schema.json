{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figthread.dev/schemas/layout-intent/0.1",
  "title": "Figthread LayoutIntent 0.1",
  "type": "object",
  "required": ["schema_version", "figure_hash", "intrinsic_metrics_hash", "target", "grammar", "regions", "constraints", "ports", "text_policy", "routing", "options", "overrides"],
  "properties": {
    "schema_version": { "const": "figthread.layout/0.1" },
    "figure_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "intrinsic_metrics_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "target": { "type": "object" }, "grammar": { "type": "object" }, "regions": { "type": "array" }, "constraints": { "type": "array" }, "ports": { "type": "object" }, "text_policy": { "type": "object" }, "routing": { "type": "object" }, "options": { "type": "object" }, "overrides": { "type": "array" }
  }
}
